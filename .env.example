# Copy to .env locally; in Coolify enter values as runtime secrets. Never commit .env.
# Local Node requires: node --env-file=.env server.js
# See docs/SUPABASE-FIRST-TIME.md before connecting a real project.
APP_MODE=saas
NODE_ENV=production
PORT=3000
APP_URL=https://venues.example.com
# Set to 1 only when exactly one trusted proxy sits in front of this service.
TRUST_PROXY=1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The legacy-compatible variable names also accept modern API keys:
# sb_publishable_... goes here (or an enabled legacy anon key).
SUPABASE_ANON_KEY=
# sb_secret_... goes here (or an enabled legacy service_role key). Server only.
SUPABASE_SERVICE_ROLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# For staging only; live deployments should use live keys and leave this false.
ALLOW_TEST_BILLING=false
REGISTRATION_ENABLED=false
SUPPORT_EMAIL=
RATE_LIMIT_SECRET=
# Optional Cloudflare Turnstile. Also configure its secret in Supabase Auth.
TURNSTILE_SITE_KEY=

# Settings / messaging (apply migration 202609290005_messaging.sql first).
# Generate privately: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Runtime only; keep a secure backup. All app instances must share this key.
INTEGRATION_ENCRYPTION_KEY=
# Keep false until providers, templates, consent and credits have been verified.
MESSAGE_WORKER_ENABLED=false
